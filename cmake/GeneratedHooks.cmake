# Idempotent BOTW v208 post-generation hooks, formerly patch_generated_hooks.ps1.
function(cafe_insert_hooks filename)
    set(_path "${GENERATED_DIR}/chunks/${filename}")
    file(READ "${_path}" _source)
    set(_original "${_source}")
    foreach(_address IN LISTS ARGN)
        set(_label "label_${_address}:")
        set(_hook "    if (ctx->host_call && ppc_host_call(ctx, 0x${_address}u)) return;")
        string(FIND "${_source}" "${_label}" _label_at)
        string(FIND "${_source}" "${_hook}" _hook_at)
        if(_label_at LESS 0)
            message(FATAL_ERROR "Missing v208 decoder label ${_label} in ${filename}")
        endif()
        if(_hook_at LESS 0)
            string(REPLACE "${_label}" "${_label}\n${_hook}" _source "${_source}")
        endif()
    endforeach()
    if(NOT _source STREQUAL _original)
        file(WRITE "${_path}" "${_source}")
    endif()
endfunction()
cafe_insert_hooks(chunk_2182_rpx1_04214020.c 04215480 042155D4 04215778)
foreach(_chunk chunk_1085_rpx1_030F0020.c chunk_1086_rpx1_030F4020.c
    chunk_1101_rpx1_03130020.c chunk_1268_rpx1_033CC020.c
    chunk_1269_rpx1_033D0020.c chunk_1396_rpx1_035CC020.c)
    set(_path "${GENERATED_DIR}/chunks/${_chunk}")
    file(READ "${_path}" _source)
    set(_original "${_source}")
    string(REGEX MATCHALL "ctx->lr = 0x[0-9A-F]+u;[\r\n]+            ctx->pc = target;[\r\n]+            return;" _matches "${_source}")
    foreach(_match IN LISTS _matches)
        # CMake lists split semicolons: collect complete statements via address,
        # then replace only an exact LR/PC/return sequence below.
        if(_match MATCHES "ctx->lr = 0x([0-9A-F]+)u")
            set(_next "${CMAKE_MATCH_1}")
            string(FIND "${_source}" "label_${_next}:" _label)
            if(NOT _label LESS 0)
                set(_replacement "ctx->lr = 0x${_next}u;\n            if (target == 0x030B0C38u) { // v208 SafeString no-op\n                ctx->pc = ctx->lr;\n                if (--ctx->downcount <= 0) return;\n                goto label_${_next};\n            }\n            ctx->pc = target;\n            return;")
                string(REGEX REPLACE "ctx->lr = 0x${_next}u;[\r\n]+            ctx->pc = target;[\r\n]+            return;" "${_replacement}" _source "${_source}")
            endif()
        endif()
    endforeach()
    if(NOT _source STREQUAL _original)
        file(WRITE "${_path}" "${_source}")
    endif()
endforeach()
cafe_insert_hooks(chunk_1269_rpx1_033D0020.c 033D2B74)
