cmake_minimum_required(VERSION 3.22)
get_filename_component(CAFE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(CAFE_TASK STREQUAL "generate")
    set(_rpx "${CAFE_ROOT}/game/update/code/U-King.rpx")
    if(NOT EXISTS "${_rpx}")
        message(FATAL_ERROR "Missing game/update/code/U-King.rpx")
    endif()
    file(SHA256 "${_rpx}" _hash)
    if(NOT _hash STREQUAL "ba58da5b95ce929e005d058ceb08b9b2788d1ab2bbc8a6c189bbadca0bb34d30")
        message(FATAL_ERROR "Unsupported RPX: expected North American BOTW v208, got ${_hash}")
    endif()
    execute_process(COMMAND "${CAFE_ROOT}/build/tools/cafe_codegen.exe" -j12 --cpu espresso
        --backend c --semantics exact "${_rpx}" "${CAFE_ROOT}/recomp"
        COMMAND_ERROR_IS_FATAL ANY)
    set(GENERATED_DIR "${CAFE_ROOT}/recomp/generated")
    include("${CMAKE_CURRENT_LIST_DIR}/GeneratedHooks.cmake")
elseif(CAFE_TASK STREQUAL "package")
    string(TIMESTAMP _version "%Y%m%d-%H%M%S")
    set(_name "CafeRecomp-source-${_version}")
    set(_release "${CAFE_ROOT}/build/releases/${_name}")
    if(EXISTS "${_release}" OR EXISTS "${_release}.zip")
        message(FATAL_ERROR "Release already exists: ${_release}")
    endif()
    file(MAKE_DIRECTORY "${_release}")
    foreach(_name_in .gitignore CMakeLists.txt CMakePresets.json build.bat README
        RELEASE-NOTES SOURCE-ORIGINS CEMU_INTEGRATION LICENSE-Cemu-MPL-2.0 LICENSE-DolRecomp-GPL-3.0)
        file(COPY "${CAFE_ROOT}/${_name_in}" DESTINATION "${_release}")
    endforeach()
    foreach(_dir src tools cmake licenses)
        file(GLOB_RECURSE _files RELATIVE "${CAFE_ROOT}" "${CAFE_ROOT}/${_dir}/*")
        foreach(_file IN LISTS _files)
            if(_dir STREQUAL "licenses" OR _file MATCHES "\\.(c|h|cpp|hpp|in|cmake|dat)$" OR _file MATCHES "/LICENSE[^/]*$")
                get_filename_component(_parent "${_release}/${_file}" DIRECTORY)
                file(MAKE_DIRECTORY "${_parent}")
                file(COPY "${CAFE_ROOT}/${_file}" DESTINATION "${_parent}")
            endif()
        endforeach()
    endforeach()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${_name}.zip" --format=zip "${_name}"
        WORKING_DIRECTORY "${CAFE_ROOT}/build/releases" COMMAND_ERROR_IS_FATAL ANY)
    file(SHA256 "${_release}.zip" _hash)
    message(STATUS "Source release: ${_release}.zip (SHA256 ${_hash})")
else()
    message(FATAL_ERROR "Unknown CAFE_TASK; use build.bat")
endif()
